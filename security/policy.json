{
  "schema_version": 1,
  "required_gates": [
    "G1",
    "G2",
    "AUTH"
  ],
  "max_evidence_age_seconds": 3600,
  "minimum_package_age_days": 7,
  "allowed_registry": "https://pypi.org",
  "allowed_artifact_host": "files.pythonhosted.org",
  "allowed_packages": [
    "annotated-doc",
    "annotated-types",
    "anyio",
    "certifi",
    "click",
    "fastapi",
    "h11",
    "httpcore",
    "httpx",
    "idna",
    "iniconfig",
    "packaging",
    "pluggy",
    "psycopg",
    "psycopg-binary",
    "pydantic",
    "pydantic-core",
    "pygments",
    "pytest",
    "starlette",
    "typing-extensions",
    "typing-inspection",
    "uvicorn"
  ],
  "gate_contracts": {
    "G1": {
      "kind": "scan"
    },
    "G2": {
      "kind": "scan",
      "coverage_required": true,
      "history_required": true
    },
    "AUTH": {
      "kind": "test",
      "case_ids": [
        "wrong password denied without session",
        "unknown user denied without session",
        "anonymous denied",
        "forged bearer denied",
        "owner reads own data",
        "owner updates own data",
        "bob: unauthorized read denied without data",
        "bob: unauthorized write denied without side effect",
        "carol: unauthorized read denied without data",
        "carol: unauthorized write denied without side effect",
        "same-tenant admin delegation allowed",
        "admin cross-tenant denied",
        "member export denied",
        "admin export tenant-scoped",
        "same-tenant admin write allowed",
        "admin cross-tenant write denied without side effect",
        "owner field cannot be reassigned",
        "logout revokes session"
      ],
      "seeded_defect_case_ids": [
        "bob: unauthorized read denied without data",
        "bob: unauthorized write denied without side effect",
        "carol: unauthorized read denied without data",
        "carol: unauthorized write denied without side effect",
        "admin cross-tenant denied",
        "admin cross-tenant write denied without side effect"
      ]
    }
  }
}
