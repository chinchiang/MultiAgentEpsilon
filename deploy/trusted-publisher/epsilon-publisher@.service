[Unit]
Description=PR %i 專用可信安全檢查發布器 / Dedicated trusted security check publisher for PR %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=epsilon-publisher
Group=epsilon-publisher
WorkingDirectory=/opt/epsilon-publisher/app
EnvironmentFile=-/etc/epsilon-publisher/network.env
# App 原始私鑰維持 root 擁有及 0600；systemd 提供服務私有的 / The App key stays root-owned (0600) on disk; systemd hands the service a private
# 唯讀副本，服務帳號不能讀取或替換原始檔。 / read-only copy, so the service account can neither read nor replace the original.
LoadCredential=github-app.pem:/etc/epsilon-publisher/github-app.pem
# 發布程式只接受 Python 3.12（例如 Ubuntu 24.04 的 /usr/bin/python3）；其他版本以 PYTHON_VERSION 拒絕。 / The publisher only
# accepts Python 3.12 (for example Ubuntu 24.04's /usr/bin/python3); other versions are refused with PYTHON_VERSION.
# 所有 PR 實例共用 publisher.lock，最多排隊 60 秒，逾時回報 LOCK_BUSY。 / All PR instances share publisher.lock and
# queue for at most 60 s, then report LOCK_BUSY.
ExecStart=/usr/bin/python3 -I /opt/epsilon-publisher/app/scripts/publish_trusted_check.py --settings /etc/epsilon-publisher/publisher.json --gate-policy /etc/epsilon-publisher/gate-policy.json --private-key ${CREDENTIALS_DIRECTORY}/github-app.pem --lock-file /var/lib/epsilon-publisher/publisher.lock --state-file /var/lib/epsilon-publisher/pr-%i-state.json --pr %i --output /var/lib/epsilon-publisher/pr-%i.json
TimeoutStartSec=300
KillMode=control-group
StateDirectory=epsilon-publisher
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/epsilon-publisher
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=64
CPUQuota=50%
