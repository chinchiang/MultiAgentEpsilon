# 僅供參考，程式讀取程序環境，不載入此檔。 / Reference only: scripts read process environment; they do not load this file.
# 機密透過安全環境設定提供，不可提交。 / Configure secrets securely in the execution environment, never commit values.
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_API_KEY=
GLM_MODEL_ID=replace-with-deployed-model-id
GLM_CHAT_URL=https://local.example.invalid/v1/chat/completions
GLM_API_KEY=
BEDROCK_MODEL_ID=
BEDROCK_REGION=ap-southeast-1
AWS_CLI_PATH=aws
# 非機密 SSO profile 設定檔路徑；Path to the nonsecret SSO profile file.
AWS_CONFIG_FILE=.state/bedrock/config
# LM Studio 本機或受控 HTTPS 入口；遠端主機須列入 security/model-roe.json 的 allowed_remote_hosts。
# Local or controlled HTTPS endpoint; a remote host must be listed in allowed_remote_hosts of security/model-roe.json.
# 以 /v1/models 的實際 ID 為準；Use the exact ID returned by /v1/models.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL_ID=nvidia/nemotron-3-nano-omni
LMSTUDIO_API_KEY=
